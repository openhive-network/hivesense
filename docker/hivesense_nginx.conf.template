#
# Homepage and endpoints of the API "Hivesense".
#
worker_processes  auto;
error_log /dev/stdout info;
worker_rlimit_nofile 8192;

events {
  worker_connections 4096;
}
http {
    access_log /dev/stdout;
    # ${RESOLVER} will be replaced by the docker entrypoint script.
    # Resolving the upstream per request (variable proxy_pass below) lets nginx
    # start while hivesense-postgrest is not yet in DNS, instead of exiting.
    resolver ${RESOLVER} valid=10s;

    # hive.rpc_form (shipped by the common-ci-configuration nginx base image)
    # forwards a GET or HEAD of an /rpc/ function as a form POST of the
    # arguments rpc_arguments.lua says it declares, so a value such as
    # not.blocktrades reaches the function instead of being read as a filter.
    init_by_lua_block {
        rpc_form = require "hive.rpc_form"
        rpc_arguments = dofile(ngx.config.prefix() .. "conf/rpc_arguments.lua")
    }
    server {
            listen 0.0.0.0:80 default_server;
            server_name _;
            # Set at server level: the 'rewrite ... break' rules in the location
            # stop any later 'set' there from running.
            set $postgrest_upstream http://hivesense-postgrest:3000;

            location / {
                    include rewrite_rules.conf;
                    # ${REWRITE_LOG} will be replaced by the docker entrypoint script.
                    # Set REWRITE_LOG=on in the environment to enable rewrite logging,
                    # otherwise it will remain disabled
                    ${REWRITE_LOG}

                    rewrite_by_lua_block {
                        rpc_form.forward(rpc_arguments)
                    }
                    header_filter_by_lua_block {
                        rpc_form.restore_head()
                    }

                    proxy_pass  $postgrest_upstream;  # my PostREST is  here!
                    # Stream what exceeds the memory buffers to the client
                    # instead of spooling it to proxy_temp: with a full or
                    # failing disk, spooling truncates exactly the large
                    # replies (e.g. ~18 MB /embedding-updates pages).
                    proxy_max_temp_file_size 0;

                    proxy_set_header Host $host;
                    proxy_set_header X-Real-IP $remote_addr;
                    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                    #default_type;
                    proxy_hide_header Content-Location;
                    proxy_set_header  Connection "";
                    proxy_http_version 1.1;
            }
    }
    server {
        listen 0.0.0.0:81;

        location /health {
            return 204;
        }
    }
}
