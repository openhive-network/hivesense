# Stage 1 – base image with only needed packages
FROM registry.gitlab.syncad.com/hive/hivesense/python:3.13-slim

# Set environment variables to reduce image size and avoid Python warnings
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    POETRY_VIRTUALENVS_CREATE=false

# Install system packages required for psycopg2 (libpq)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Create working directory and copy script
WORKDIR /app
COPY scripts/sync_embeddings.py .

# Install only necessary Python packages
RUN pip install --no-cache-dir \
    psycopg2-binary \
    requests

# Default command
CMD ["python", "sync_embeddings.py"]
