FROM ollama/ollama:0.18.0 AS binary-source
FROM debian:bookworm-slim

# Add CA certs and other basic runtime deps
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy Ollama binary
COPY --from=binary-source /usr/bin/ollama /usr/local/bin/ollama

ENV OLLAMA_HOST=0.0.0.0:11434
EXPOSE 11434
ENTRYPOINT ["/usr/local/bin/ollama"]
CMD ["serve"]
